{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krillion-practice",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "SITE_ORIGIN": "https://unlimited-krillion.com",
    "ADSENSE_PUBLISHER_ID": "ca-pub-1089347748089061",
    "ADSENSE_ENABLED": "true",
    "ADSENSE_GUIDE_SLOT": "2717459333",
    "GA4_MEASUREMENT_ID": "G-MMX9M6NGMS"
  },
  "routes": [
    {
      "pattern": "unlimited-krillion.com/*",
      "zone_name": "unlimited-krillion.com"
    },
    {
      "pattern": "www.unlimited-krillion.com",
      "custom_domain": true
    }
  ]
}
